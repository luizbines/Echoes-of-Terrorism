View(trends)
# --- Function to Run Regressions ---
run_feols <- function(var) {
fml <- as.formula(paste(var, "~ alert + lag_alert_1 + lag_alert_2 | District + as.factor(year)"))
feols(fml, data = trends, se = 'standard')
}
# Run all regressions
all_regs <- map(set_names(unlist(groups)), run_feols)
# --- Function to Run Regressions ---
run_feols <- function(var) {
fml <- as.formula(paste(var, "~ alert + lag_alert_1 + lag_alert_2 | District + as.factor(year)"))
feols(fml, data = trends, se = 'standard')
}
# Run all regressions
all_regs <- map(set_names(unlist(groups)), run_feols)
run_feols()
# --- Define Groups for Tables ---
groups <- list(
security = c("shelter", "emergency", "hospitals", "siren", "protected_space",
"home_front_command", "code_red", "panic_attack", "mda"),
conflict = c("peace", "war", "terrorism", "ceasefire", "hamas"),
politics = c("elections", "likud", "netanyahu", "government"),
ideology = c("annexation", "sovereignty", "settlements", "palestinian_state")
)
# --- Function to Run Regressions ---
run_feols <- function(var) {
fml <- as.formula(paste(var, "~ alert + lag_alert_1 + lag_alert_2 | District + as.factor(year)"))
feols(fml, data = trends, se = 'standard')
}
# Run all regressions
all_regs <- map(set_names(unlist(groups)), run_feols)
View(all_regs)
# --- Generate Tables ---
walk2(groups, names(groups), ~ {
modelsummary(
all_regs[.x],
output = paste0('Trends/treating/Israel/output/reg_table_', .y, '.tex'),
coef_map = c('alert' = 'Red Alert',
'lag_alert_1' = 'Red Alert - lag 1',
'lag_alert_2' = 'Red Alert - lag 2'),
stars = TRUE,
gof_map = c("nobs", "r.squared")
)
})
# --- Plotting All Variables ---
all_vars <- unlist(groups)
all_vars
all_vars[1]
all_vars[1] %>% print
walk(all_vars, ~ {
plot <- ggplot(trends, aes(x = date, y = .data[[.x]])) +
geom_line(color = "gray30", alpha = 0.5, size = 0.7) +
geom_point(data = trends[trends$alert > 0,],
aes(x = date, y = .data[[.x]], color = alert), size = 2) +
labs(x = "Date", y = paste("Searches for", toupper(.x), "(0-100)")) +
theme_minimal() +
facet_wrap(~ District, scales = "free_y") +
scale_color_viridis_c(option = "plasma", direction = -1,
name = "Alert Exposure") +
theme(legend.position = "bottom",
strip.text = element_text(size = 8))
file_name <- paste0("Trends/treating/Israel/output/plots/trend_", .x, ".pdf")
ggsave(filename = file_name, plot = plot, width = 10, height = 6)
})
# This file runs the main regressions and plots relevant graphs
# Luiz Bines - Updated December 2025
# luizbines@gmail.com
# Libraries
library(dplyr)
library(sf)
library(tidyr)
library(data.table)
library(fixest)
library(ggplot2)
library(purrr)
library(modelsummary)
# Directory
# Directory
wd <- '/home/luiz/Documentos/GitHub/Echoes-of-Terrorism/'
setwd(wd)
# Importing Data
trends <- read.csv('Trends/cleaning/Red Alerts/output/trends_alerts_data_v2.csv',
fileEncoding = "UTF-8") %>%
mutate(across(-c(District), as.numeric))
# Data Cleaning, Lag Generation, and Translation
trends <- trends %>%
group_by(District) %>%
arrange(year, month) %>%
mutate(
lag_alert_1 = lag(alert, 1),
lag_alert_2 = lag(alert, 2),
# Fill NAs with 0 (assuming no alerts prior to data start)
lag_alert_1 = ifelse(is.na(lag_alert_1), 0, lag_alert_1),
lag_alert_2 = ifelse(is.na(lag_alert_2), 0, lag_alert_2)
) %>%
ungroup() %>%
arrange(District) %>%
mutate(
# Setting date as first day of each month
date = as.Date(paste(year, month, "01", sep = "-"))
) %>%
# Translating Hebrew variables to English
rename(
# Group 1: Security & Practical
shelter = מקלט,
emergency = חירום,
hospitals = בתי.חולים,
siren = אזעקה,
protected_space = מרחב.מוגן,
home_front_command = פיקוד.העורף,
code_red =  צבע.אדום,
panic_attack = התקף.חרדה,
mda = מד.א,
# Group 2: General & Conflict
peace = שלום,
war = מלחמה,
terrorism = טרור,
ceasefire = הפסקת.אש,
hamas = חמאס,
# Group 3: Political Institutions/Events
elections = בחירות,
likud = ליכוד,
netanyahu = נתניהו,
government = ממשלה,
# Group 4: Ideological Indicators
annexation = סיפוח,
sovereignty = ריבונות,
settlements = התנחלויות,
palestinian_state = מדינה.פלסטינית
)
# --- Define Thematic Groups for Tables ---
# We split 22 variables into 4 tables to avoid overcrowding the LaTeX output
groups_list <- list(
'security_practical' = c("shelter", "emergency", "hospitals", "siren", "protected_space"),
'response_sentiment' = c("home_front_command", "code_red", "panic_attack", "mda", "peace"),
'war_politics'       = c("war", "terrorism", "ceasefire", "hamas", "elections"),
'ideology_party'     = c("likud", "netanyahu", "government", "annexation", "sovereignty", "settlements", "palestinian_state")
)
# --- Run All Regressions ---
# We use purrr::map to run all 22 fixed-effects models at once
all_vars <- unlist(groups_list)
all_regs <- map(set_names(all_vars), ~ {
fml <- as.formula(paste(.x, "~ alert + lag_alert_1 + lag_alert_2 | District + as.factor(year)"))
feols(fml, data = trends, se = 'standard')
})
# --- Export Regression Tables (LaTeX) ---
# This loop generates 4 separate .tex files
i <- 1
walk2(groups_list, names(groups_list), ~ {
# Filter models for the current group
current_models <- all_regs[.x]
# Format column names: underscores to spaces and Title Case
# e.g., "protected_space" -> "Protected Space"
clean_col_names <- gsub("_", " ", .x) %>% tools::toTitleCase()
modelsummary(
current_models,
output = paste0('Trends/treating/Israel/output/tables/trends_table_part', i, '_', .y, '.tex'),
coef_map = c('alert' = 'Red Alert',
'lag_alert_1' = 'Red Alert - lag 1',
'lag_alert_2' = 'Red Alert - lag 2'),
stars = TRUE,
names = clean_col_names,
gof_map = c("nobs", "r.squared"),
title = paste("Effect of Red Alerts on Google Searches - Group:", tools::toTitleCase(gsub("_", " ", .y)))
)
i <<- i + 1
})
