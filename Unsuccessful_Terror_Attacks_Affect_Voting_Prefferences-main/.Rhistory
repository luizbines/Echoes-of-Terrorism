cval = crit_values)
ggplot(crit_df, aes(x = theta0, y = cval)) +
geom_line(color = 'blue') +
ylim(2.5, 4) +
labs(
title = expression('Critical value ' * C( theta[0] ) * ' for ' * alpha * '=0.05'),
y = expression(C(theta[0])),
x = expression(theta[0])
)
# Thetas of interest (x axis)
theta0_grid = seq(-3, 3, length.out = 310)
LR_matrix = sapply(theta0_grid, function(theta0) {
# X as a function of Z and theta0
X <- Z + theta0
LR(X, theta0)
})
# Computing critical values (95th percentile) of LR under H0
# THIS IS THE HINT PART. THANKS ORIOL :)
crit_values = apply(LR_matrix, MARGIN = 2, quantile, probs = 0.95)
# Creating dataframe with all stored values
crit_df = data.frame(theta0 = theta0_grid,
cval = crit_values)
ggplot(crit_df, aes(x = theta0, y = cval)) +
geom_line(color = 'blue') +
ylim(2.5, 4) +
labs(
title = expression('Critical value ' * C( theta[0] ) * ' for ' * alpha * '=0.05'),
