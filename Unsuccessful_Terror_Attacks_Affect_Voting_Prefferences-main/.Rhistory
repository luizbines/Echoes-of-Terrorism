distribution_intra <- red_alerts %>%
group_by(SEMEL_YISHUV) %>%
mutate(total_alerts_local = n()) %>% # Total de alertas daquela cidade
group_by(SEMEL_YISHUV, temporal_distance) %>%
summarise(
# Proporção: quantos % dos alertas da cidade X ocorreram no dia T?
pct_alerts = n() / first(total_alerts_local),
.groups = 'drop'
)
# 2. Visualização para checar a variação (Curva de Densidade ou Média)
ggplot(distribution_intra, aes(x = temporal_distance, y = pct_alerts)) +
geom_line(aes(group = SEMEL_YISHUV), alpha = 0.05, color = "gray") + # Cada linha é uma cidade
geom_smooth(color = "blue", method = "gam") + # Tendência média de todas as cidades
scale_x_reverse() + # Inverte para que a eleição (0 ou 1) fique à direita
labs(
title = "Distribuição Intra-Localidade dos Alertas",
subtitle = "Cada linha representa o perfil temporal de uma cidade (normalizado)",
x = "Dias Antes da Eleição",
y = "% do Total de Alertas da Localidade"
) +
theme_minimal()
