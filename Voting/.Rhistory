parties_percentages_panel = read_csv('treating/Red Alerts/Output/2_parties_percentages_panel.csv')
### FILTERING ###
# filtering years
parties_percentages_panel = parties_percentages_panel %>%
filter(year <= 2015) %>%
mutate(year = as.integer(year)) %>%
