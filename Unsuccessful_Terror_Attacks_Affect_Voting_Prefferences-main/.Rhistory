filter(temporal_distance <= 0) %>% # Foco nos dias que antecedem a eleição
group_by(SEMEL_YISHUV, temporal_distance) %>%
summarise(daily_alerts = n(), .groups = 'drop')
# Visualização sugerida para checar a variação
library(ggplot2)
ggplot(red_alerts_distribution, aes(x = temporal_distance, y = daily_alerts, group = SEMEL_YISHUV)) +
geom_line(alpha = 0.1) + # Linhas transparentes para ver a massa de dados
geom_smooth(aes(group = 1), color = "red") + # Tendência média
labs(title = "Distribuição de Alertas por Localidade",
x = "Dias para a Eleição (0 = Dia da Eleição)",
y = "Número de Alertas")
