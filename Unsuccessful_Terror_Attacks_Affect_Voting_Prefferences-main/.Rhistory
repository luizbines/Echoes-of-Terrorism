theta0_grid = seq(0, 3, length.out = 310)
LR_matrix = sapply(theta0_grid, function(theta0) {
# X as a function of Z and theta0
X <- Z + theta0
LR(X, theta0)
})
# Computing critical values (95th percentile) of LR under H0
# THIS IS THE HINT PART. THANKS ORIOL :)
crit_values = apply(LR_matrix, MARGIN = 2, quantile, probs = 0.95)
# Creating dataframe with all stored values
crit_df = data.frame(theta0 = theta0_grid,
cval = crit_values)
ggplot(crit_df, aes(x = theta0, y = cval)) +
geom_line(color = 'blue') +
ylim(2.5, 4) +
labs(
title = expression('Critical value ' * C( theta[0] ) * ' for ' * alpha * '=0.05'),
y = expression(C(theta[0])),
x = expression(theta[0])
)
# Critical value when theta0 = 0 and alpha = 0.05
c0 = crit_values[1]
# Theta values
theta_alt = seq(0, 5, length.out = 400)
# Simulating Z ~ N(0,1)
Z2 = rnorm(n_sim)
# Computing power under each Theta (by quantile approximation)
power_vals = sapply(theta_alt, function(theta) {
# X ~ N(theta, 1)
X <- Z2 + theta
# Beta is the probability of rejecting H0
# This is an approximation of P(LR > c(0))
mean(LR(X,0) > c0)        # proportion of times LR > critical value
})
# Df to store power and theta values
power_df = data.frame(theta = theta_alt, beta = power_vals)
# Plotting
ggplot(power_df, aes(x = theta, y = beta)) +
geom_line(color = 'red') +
labs(
title = 'Power Function',
y = expression(beta(theta)),
x = expression(theta)
)
